<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Folder row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_browse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse" />

            <TextView
                android:id="@+id/txt_folder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="middle"
                android:gravity="center_vertical|start"
                android:singleLine="true"
                android:text="@string/no_folder_selected"
                android:textColor="#777777" />

            <Button
                android:id="@+id/btn_files"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_files" />
        </LinearLayout>

        <!-- Recompression -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/recompress_label"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_compressmode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_compressnone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/compressmode_none" />

            <RadioButton
                android:id="@+id/radio_compresswebp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compressmode_webp" />

            <RadioButton
                android:id="@+id/radio_compressheic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compressmode_heic" />

            <RadioButton
                android:id="@+id/radio_compressavif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compressmode_avif" />

            <RadioButton
                android:id="@+id/radio_compressjpeg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/compressmode_jpeg" />
        </RadioGroup>

        <!-- Quality -->
        <LinearLayout
            android:id="@+id/quality_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_label" />

            <SeekBar
                android:id="@+id/seek_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="80" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_skip_fav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/skip_favorites" />

        <CheckBox
            android:id="@+id/check_skip_low_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/skip_low_gain" />

        <CheckBox
            android:id="@+id/check_keep_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keep_original" />

        <!-- Group into folders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/groupfolder_label"
            android:textAllCaps="true"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_groupmode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_groupnone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/groupmode_none" />

            <RadioButton
                android:id="@+id/radio_groupplacemonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/groupmode_placemonth" />

            <RadioButton
                android:id="@+id/radio_groupplaceday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/groupmode_placeday" />
        </RadioGroup>

        <!-- Date range -->
        <LinearLayout
            android:id="@+id/date_range_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/date_range_label"
                android:textAllCaps="true"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_date_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/date_from_label" />

                <Button
                    android:id="@+id/btn_date_to"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/date_to_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plan summary -->
        <TextView
            android:id="@+id/txt_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/preview" />

            <Button
                android:id="@+id/btn_organize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/organize" />
        </LinearLayout>

        <!-- Progress (hidden until Organize runs) -->
        <LinearLayout
            android:id="@+id/progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/txt_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="@string/stop" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
