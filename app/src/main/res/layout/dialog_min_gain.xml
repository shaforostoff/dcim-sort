<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press overlay for the skip-low-gain threshold (see MainActivity.showMinGainDialog). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/txt_min_gain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp" />

    <!-- SeekBar has no android:min below API 26, so progress carries value − 1 (range 1…99). -->
    <SeekBar
        android:id="@+id/seek_min_gain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="98" />
</LinearLayout>
