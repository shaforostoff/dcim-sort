<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- heifwriter declares minSdk 28; we only invoke it behind API-28 runtime gates. -->
    <uses-sdk tools:overrideLibrary="androidx.heifwriter" />

    <!-- Reading images: READ_MEDIA_IMAGES on 33+, READ_EXTERNAL_STORAGE on <=32. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Writing/moving files directly is only needed on legacy (<=28) storage. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Required (29+) to read un-redacted EXIF GPS from MediaStore images. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Online reverse-geocode fallback when Geocoder is unavailable. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Long-running Organize runs in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DCIMSort">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DCIMSort"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FolderPickerActivity"
            android:exported="false"
            android:label="@string/title_pick_folder" />

        <activity
            android:name=".ui.PreviewActivity"
            android:exported="false"
            android:label="@string/title_preview" />

        <activity
            android:name=".ui.ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.DCIMSort.Fullscreen" />

        <service
            android:name=".work.OrganizeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
